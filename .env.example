# === Supabase ===
# Create a project at https://supabase.com, then run supabase/migrations/0001_init.sql
# in the SQL editor. Without these three set, the app falls back to an
# in-memory store for leads/calls (fine for local demoing, not for production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === App URL ===
# Used to build the Sarvam webhook callback URL. Must be a publicly
# reachable HTTPS URL (your Vercel deployment URL, or an ngrok/tunnel URL
# for local testing) — Sarvam cannot call back to localhost.
NEXT_PUBLIC_APP_URL=

# === Sarvam (Instant Outbound Voice Agent) ===
# All required for Real Mode. If any is missing, the app runs in Demo Mode
# with a simulated call instead — see README "Demo Mode vs Real Mode".
#
# Get these from your Sarvam dashboard (https://dashboard.sarvam.ai):
SARVAM_API_KEY=
# Maps to the Sarvam "app_id" for your configured voice agent.
SARVAM_AGENT_ID=
# The outbound caller ID Sarvam dials from (agent_phone_number).
SARVAM_PHONE_NUMBER=
# Sarvam's Instant Outbound API additionally scopes every call under an
# org / workspace / telephony connection — see README "Sarvam setup".
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_CONNECTION_ID=
# Optional. Leave unset to always call the agent's latest COMMITTED version
# in Sarvam — edits you commit in the Sarvam dashboard go live immediately,
# no redeploy needed. Set to a specific number (e.g. 3) to pin production to
# that version regardless of later edits/commits in Sarvam.
SARVAM_APP_VERSION=
# Optional: if set, the webhook endpoint requires ?secret=<this value> on
# incoming requests. Sarvam does not document webhook signing. The app
# appends this query param to webhook_config.url on each outbound call.
SARVAM_WEBHOOK_SECRET=

# === Sarvam Chat (Conversation Intelligence) ===
# A SEPARATE key from SARVAM_API_KEY above — that one is for the Voice
# Agents / Instant Outbound product. This one is for Sarvam's general Chat
# Completions API (get it from the "Sarvam API" product at
# https://indus.sarvam.ai, not the Voice Agents console), used to turn a
# completed call's transcript into structured Conversation Intelligence.
# If unset, the call result page still works — the Conversation
# Intelligence section shows "temporarily unavailable" instead of crashing.
SARVAM_CHAT_API_KEY=

# Dedicated public live-demo agent. Commit src/lib/sarvam/public-demo-prompt.ts
# as the agent's stable instructions in Sarvam; property agent stays separate.
SARVAM_DEMO_AGENT_ID=
SARVAM_DEMO_APP_VERSION=1

# Contact inquiry notifications — server-only. Use a verified Resend sender.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
